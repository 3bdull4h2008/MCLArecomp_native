      "id": "main",
      "title": "LAUNCHER",
      "icon": "play",
      "visible": true,
      "isHome": true,
      "items": [
        {
          "id": "play",
          "type": "action",
          "visible": true,
          "label": "PLAY",
          "sub": "LAUNCH MCLA.EXE (MCLA-RECOMP)",
          "action": "launchGame"
        },
        {
          "id": "nav_display",
          "type": "nav",
          "visible": true,
          "label": "DISPLAY & VIDEO",
          "targetTab": "display"
        },
        {
          "id": "nav_graphics",
          "type": "nav",
          "visible": true,
          "label": "GRAPHICS & SHADOWS",
          "targetTab": "graphics"
        },
        {
          "id": "nav_controls",
          "type": "nav",
          "visible": true,
          "label": "CONTROLS & KEYMAP",
          "targetTab": "controls"
        },
        {
          "id": "nav_tuning",
          "type": "nav",
          "visible": true,
          "label": "TUNING & PERF",
          "targetTab": "tuning"
        },
        {
          "id": "nav_more",
          "type": "nav",
          "visible": true,
          "label": "MORE & TOOLS",
          "targetTab": "files"
        },
        {
          "id": "exit",
          "type": "action",
          "visible": true,
          "label": "EXIT LAUNCHER",
          "action": "exitLauncher"
        }
      ]
    },
